[Unit]
Description=CLIPZIDA Discord review bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipzida
Group=clipzida
WorkingDirectory=/home/clipzida/clipping_tools
EnvironmentFile=/home/clipzida/clipping_tools/.env
Environment=CLIPZIDA_DB=/home/clipzida/clipping_tools/data/state.db
ExecStart=/home/clipzida/.local/bin/uv run clipping-tools review-bot
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

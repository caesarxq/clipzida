[Unit]
Description=CLIPZIDA pipeline health monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=clipzida
Group=clipzida
WorkingDirectory=/home/clipzida/clipping_tools
EnvironmentFile=/home/clipzida/clipping_tools/.env
Environment=CLIPZIDA_DB=/home/clipzida/clipping_tools/data/state.db
ExecStart=/home/clipzida/.local/bin/uv run clipping-tools monitor

[Install]
WantedBy=multi-user.target
